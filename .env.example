# Arbitron environment template — docs/01 section J.
# Copy to .env and fill in. Never commit .env; never paste secrets into docs/02-BLOCKERS.md.
# LIVE_MODE stays false until the owner has cleared every HARD blocker (docs/02).

# --- Supabase (blocker B-06) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/arbitron

# --- Queues (blocker B-07) ---
REDIS_URL=redis://localhost:6379

# --- LLM (blocker B-08) ---
# Model names are configuration, never hard-coded (docs/01 section C).
ANTHROPIC_API_KEY=
LLM_MODEL_SCORE=claude-opus-5
LLM_MODEL_DRAFT=claude-opus-5

# --- Freelancer.com (blockers B-03, B-04, B-05) ---
FREELANCER_CLIENT_ID=
FREELANCER_CLIENT_SECRET=
FREELANCER_REDIRECT_URI=http://localhost:3000/auth/freelancer/callback
# Sandbox while developing; the live base URL is only used once LIVE_MODE=true.
FREELANCER_BASE_URL=https://www.freelancer-sandbox.com

# --- Telegram (blocker B-09) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Email (blocker B-13) ---
EMAIL_PROVIDER_KEY=

# --- FX rates (blocker B-10) ---
FX_API_URL=
FX_API_KEY=

# --- App URLs ---
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# --- Safety gate (docs/01 section H) ---
# false blocks every outbound marketplace call and logs what would have been sent.
LIVE_MODE=false

# --- Phase 3+ (blocker B-14) ---
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=

# --- Phase 4 (blocker B-15) ---
PAYSTACK_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
