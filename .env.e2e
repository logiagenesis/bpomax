# The end-to-end build only (`pnpm build:web:e2e`, which is `vite build --mode e2e`).
# Stand-ins: the Playwright specs answer every request to these hosts at the network
# edge, so nothing here is real and nothing here is a secret. A production build reads
# the same three names from .env or the host's environment (apps/web/vite.config.js).
SUPABASE_URL=https://e2e.supabase.invalid
SUPABASE_ANON_KEY=e2e-anon-key
API_URL=https://e2e-api.invalid
