# The demo build only (`pnpm build:web:demo`, which is `vite build --mode demo`; D-043).
# Stand-in hosts: src/demo/demo.js answers every request to them inside the browser with
# sample data, so nothing here is real and nothing here is a secret. A production build
# reads the same three names from .env or the host's environment instead.
SUPABASE_URL=https://demo.supabase.invalid
SUPABASE_ANON_KEY=demo-anon-key
API_URL=https://demo-api.invalid
