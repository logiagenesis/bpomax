{
  "name": "@arbitron/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Supabase migrations, seed data and generated types",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types.generated.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2"
  },
  "dependencies": {
    "@arbitron/core": "workspace:*"
  }
}
